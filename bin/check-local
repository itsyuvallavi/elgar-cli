#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> cargo fmt --check"
cargo fmt --check

echo "==> cargo check -p elgar-core"
cargo check -p elgar-core

echo "==> cargo check -p elgar-tui"
cargo check -p elgar-tui

echo "==> cargo check -p elgar-cli"
cargo check -p elgar-cli

echo "==> cargo test -p elgar-tui"
cargo test -p elgar-tui

echo "==> cargo test -p elgar-cli"
cargo test -p elgar-cli

echo "==> local checks passed"
