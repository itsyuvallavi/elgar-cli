#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
playground="$repo_root/playground"
mkdir -p "$playground"

if ! command -v elgar >/dev/null 2>&1; then
  echo "missing elgar binary; run ./bin/install-local first" >&2
  exit 1
fi

if [[ "${ELGAR_PROVIDER_CONFIG:-}" =~ ^(off|none|disabled)$ ]]; then
  echo "ELGAR_PROVIDER_CONFIG disables live provider config; unset it for this dogfood run" >&2
  exit 1
fi

stamp="$(date +%Y%m%d-%H%M%S)-$$"
project_dir="review-policy-$stamp"
input_file="$playground/.dogfood-review-approval-policy-$stamp.in"
output_file="$playground/.dogfood-review-approval-policy-$stamp.out"
timeout_seconds="${ELGAR_DOGFOOD_TIMEOUT_SECONDS:-700}"

cat >"$input_file" <<EOF
/permissions review_all
create a tiny config project folder named $project_dir inside the current playground folder.
/pending
/approve
create README.md inside $project_dir with a concise project title.
/pending
/approve
create config/settings.json inside $project_dir with a small JSON object containing enabled true.
/pending
/approve
/state
/memory
run ls in the $project_dir folder
/pending
/approve
/pending
/reasoning
/exit
EOF

echo "==> running live review-approval-policy dogfood"
set +e
(
  cd "$playground"
  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$timeout_seconds" elgar tui <"$input_file"
  else
    elgar tui <"$input_file"
  fi
) | tee "$output_file"
run_status=${PIPESTATUS[0]}
set -e

fail() {
  echo "dogfood failed: $1" >&2
  echo "transcript: $output_file" >&2
  exit 1
}

[[ "$run_status" -eq 0 ]] || fail "elgar tui exited nonzero or timed out after ${timeout_seconds}s"

grep -q "stub provider response" "$output_file" && fail "script used stub provider"
grep -q "No live provider call was made" "$output_file" && fail "script used no-network provider"
grep -q "Network provider error" "$output_file" && fail "live provider returned a network error"
grep -q "Permission mode set to review_all" "$output_file" || fail "review_all mode was not set"
grep -Eq "Pending Action|pending:|Approve" "$output_file" || fail "review mode did not expose pending action"

project_path="$playground/$project_dir"
[[ -d "$project_path" ]] || fail "approved project directory was not created"
[[ -f "$project_path/README.md" ]] || fail "approved README.md missing"
[[ -f "$project_path/config/settings.json" ]] || fail "approved config/settings.json missing"

grep -q "Shell command finished: exit 0" "$output_file" || fail "ls shell command did not execute"
grep -q "README.md" "$output_file" || fail "ls output did not include README.md"
grep -q "config" "$output_file" || fail "ls output did not include config"
grep -q '^Memory$' "$output_file" || fail "memory output missing"
grep -q '^Reasoning$' "$output_file" || fail "reasoning output missing"
grep -q "requested shell_command" "$output_file" || fail "reasoning did not record shell command"
grep -q "Pending Action"$'\n'"none" "$output_file" || fail "pending action did not clear by end"

echo "==> dogfood passed"
echo "project: $project_path"
echo "transcript: $output_file"
