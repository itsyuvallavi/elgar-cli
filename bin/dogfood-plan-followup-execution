#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
playground="$repo_root/playground"
mkdir -p "$playground"

if ! command -v elgar >/dev/null 2>&1; then
  echo "missing elgar binary; run ./bin/install-local first" >&2
  exit 1
fi

if [[ "${ELGAR_PROVIDER_CONFIG:-}" =~ ^(off|none|disabled)$ ]]; then
  echo "ELGAR_PROVIDER_CONFIG disables live provider config; unset it for this dogfood run" >&2
  exit 1
fi

stamp="$(date +%Y%m%d-%H%M%S)-$$"
project_dir="plan-followup-execution-$stamp"
input_file="$playground/.dogfood-plan-followup-execution-$stamp.in"
output_file="$playground/.dogfood-plan-followup-execution-$stamp.out"
final_plan_file="$playground/.dogfood-plan-followup-execution-$stamp.final-plan"
first_plan_file="$playground/.dogfood-plan-followup-execution-$stamp.first-plan"
final_tokens_file="$playground/.dogfood-plan-followup-execution-$stamp.final-tokens"
timeout_seconds="${ELGAR_DOGFOOD_TIMEOUT_SECONDS:-300}"

cat >"$input_file" <<EOF
/permissions full_access
create only a project plan for a tiny Python CLI todo app inside a new folder named $project_dir. Do not implement it yet. The plan must include README.md, src/main.py, and requirements.txt, plus verification and acceptance criteria.
/plan
/memory
please execute the plan you just created
/plan
/memory
/tokens
/reasoning
run ls in the project folder you just created
/tokens
/reasoning
/exit
EOF

echo "==> running live plan-followup execution dogfood"
set +e
(
  cd "$playground"
  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$timeout_seconds" elgar tui <"$input_file"
  else
    elgar tui <"$input_file"
  fi
) | tee "$output_file"
run_status=${PIPESTATUS[0]}
set -e

fail() {
  echo "dogfood failed: $1" >&2
  echo "transcript: $output_file" >&2
  exit 1
}

[[ "$run_status" -eq 0 ]] || fail "elgar tui exited nonzero or timed out after ${timeout_seconds}s"

grep -q "stub provider response" "$output_file" && fail "script used stub provider"
grep -q "No live provider call was made" "$output_file" && fail "script used no-network provider"
grep -q "Network provider error" "$output_file" && fail "live provider returned a network error"
grep -q "waiting for approval" "$output_file" && fail "script left a pending approval; expected full_access auto-apply"
grep -Eiq "haven.?t.*created a plan|provide the details of the plan|which file contains the plan" "$output_file" \
  && fail "plan follow-up fell back to stale guidance instead of verified memory"

project_path="$playground/$project_dir"
[[ -d "$project_path" ]] || fail "missing project directory $project_dir"
find "$project_path" -maxdepth 1 -iname '*plan*.md' -type f | grep -q . \
  || fail "missing plan markdown file"
[[ -f "$project_path/README.md" ]] || fail "missing README.md"
[[ -f "$project_path/src/main.py" ]] || fail "missing src/main.py"
[[ -f "$project_path/requirements.txt" ]] || fail "missing requirements.txt"

awk '
  $0 == "Plan Preview" { capture = 1; block = $0 "\n"; next }
  capture && $0 == "" { printf "%s", block; exit }
  capture { block = block $0 "\n" }
  END {
    if (capture) {
      printf "%s", block
    }
  }
' "$output_file" >"$first_plan_file"

grep -q "status: verified" "$first_plan_file" || fail "initial plan preview did not remain verified before execution"
grep -q -- "- missing playground/$project_dir/README.md" "$first_plan_file" \
  || fail "plan-only turn created README.md before the execute follow-up"
grep -q -- "- missing playground/$project_dir/src/main.py" "$first_plan_file" \
  || fail "plan-only turn created src/main.py before the execute follow-up"
grep -q -- "- missing playground/$project_dir/requirements.txt" "$first_plan_file" \
  || fail "plan-only turn created requirements.txt before the execute follow-up"

awk '
  $0 == "Plan Preview" { capture = 1; block = $0 "\n"; next }
  capture && $0 == "" { latest = block; capture = 0; next }
  capture { block = block $0 "\n" }
  END {
    if (capture) {
      latest = block
    }
    printf "%s", latest
  }
' "$output_file" >"$final_plan_file"

grep -q "status: completed" "$final_plan_file" || fail "final plan preview did not complete"
grep -q "blocking issues: none" "$final_plan_file" || fail "final plan contract still has blocking issues"
grep -q -- "- ok playground/$project_dir/README.md" "$final_plan_file" \
  || fail "final plan preview did not show README.md present"
grep -q -- "- ok playground/$project_dir/src/main.py" "$final_plan_file" \
  || fail "final plan preview did not show src/main.py present"
grep -Eq -- "- (ok|empty) playground/$project_dir/requirements.txt" "$final_plan_file" \
  || fail "final plan preview did not show requirements.txt present"
grep -q -- "- missing playground/$project_dir/" "$final_plan_file" \
  && fail "final plan preview still has missing expected paths"

grep -q '^Memory$' "$output_file" || fail "memory output missing"
grep -q "structured plans" "$output_file" || fail "structured plan memory missing"
grep -q "completed verified-plan" "$output_file" || fail "memory did not mark structured plan completed"
grep -q "README.md" "$output_file" || fail "ls output did not show README.md"
grep -q "requirements.txt" "$output_file" || fail "ls output did not show requirements.txt"
grep -q "src" "$output_file" || fail "ls output did not show src"

awk '
  $0 == "Tokens" { capture = 1; block = $0 "\n"; next }
  capture && $0 == "Reasoning" { capture = 0; latest = block; next }
  capture { block = block $0 "\n" }
  END {
    if (capture) {
      latest = block
    }
    printf "%s", latest
  }
' "$output_file" >"$final_tokens_file"

grep -q '^Tokens$' "$final_tokens_file" || fail "tokens output missing"
grep -q "last turn requests:" "$final_tokens_file" || fail "tokens missing request breakdown"
grep -q "tool_enabled" "$final_tokens_file" || fail "shell/action turn did not use tool-enabled request"

grep -q '^Reasoning$' "$output_file" || fail "reasoning output missing"
grep -q '^route:' "$output_file" || fail "reasoning route missing"
grep -q '^runtime checks:' "$output_file" || fail "reasoning runtime checks missing"
grep -q "route: plan_execution" "$output_file" || fail "reasoning did not record plan_execution route"
grep -q "requested shell_command" "$output_file" || fail "reasoning did not record shell command request"

echo "==> dogfood passed"
echo "project: $project_path"
echo "transcript: $output_file"
